# Backend environment (Northflank / local). Copy into deployment secrets; do not commit real values.
#
# Local: a file named `.env` at the repo root (next to `requirements.txt`) or under `src/.env` is
# loaded automatically when `python-dotenv` is installed (see `Justchat/settings.py`).

# --- Database (PostgreSQL / Neon) ---
# If unset, Django uses SQLite at src/db.sqlite3 (easy to get "no such table" if you never migrated that file).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
# If connection fails, try without channel_binding=require on the query string.

# --- CORS / CSRF (frontend -> backend) ---
# When CORS_ALLOWED_ORIGINS is set, ONLY those origins can call the API (browser blocks others).
# POST /rest-auth/social/google/ sends JSON → browser runs a preflight OPTIONS; the Origin header
# must match an entry below exactly (scheme + host, no path, no trailing slash).
# Include your deployed frontend origins.
# CORS_ALLOWED_ORIGINS=https://lets-chat-gray.vercel.app,https://lets-chat-git-release-frontend-abdulrahman9901s-projects.vercel.app
# Optional regex for Vercel preview URLs:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://lets-chat-git-.*-abdulrahman9901s-projects\\.vercel\\.app$
# Needed if frontend sends credentials: 'include'
# CORS_ALLOW_CREDENTIALS=true
# If using cookie/session auth or CSRF-protected endpoints from frontend, trust these origins too.
# Include your backend public URL if /admin/ login returns 403 (CSRF) behind Northflank:
# CSRF_TRUSTED_ORIGINS=https://p01--lets-chat-backend--z4h9tx526rgd.code.run,https://lets-chat-gray.vercel.app
#
# Northflank terminates TLS; Django must trust X-Forwarded-Proto / Host or CSRF/cookies break on /admin/:
# TRUST_BEHIND_PROXY=true

# --- Email (OTP verification) ---
# If EMAIL_HOST is missing or empty at runtime, Django uses the CONSOLE backend only.
# Brevo will show ZERO sends in that case — OTP appears in Northflank logs, not inboxes.

# Brevo SMTP (use the SMTP key from Brevo as password, not your Brevo login password):
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Login = often your Brevo account email, or the SMTP login shown in Brevo
EMAIL_HOST_USER=
# Password = "SMTP key" / "Master password" from Brevo SMTP settings
EMAIL_HOST_PASSWORD=
# Must be a sender you verified in Brevo (can be your Gmail if verified there)
DEFAULT_FROM_EMAIL=

# Optional
# EMAIL_TIMEOUT=20
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_OTP_SUBJECT=Verify your email
# Dev only, insecure: bypass TLS certificate verification for SMTP.
# EMAIL_SSL_NO_VERIFY=true

# Verify from the running container (Northflank shell / one-off job):
#   cd src && python manage.py email_smtp_check
#   python manage.py email_smtp_check --send your-email@example.com

# EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
# EMAIL_VERIFICATION_DELETE_AFTER_HOURS=2

# --- Social OAuth (allauth + dj-rest-auth) ---
# Add matching SocialApp entries in Django admin for each provider with same client id/secret.
# Callback URLs must match frontend callback routes and provider console settings exactly.
#
# SOCIAL_GOOGLE_CALLBACK_URL=https://lets-chat-gray.vercel.app/oauth/callback/google
# SOCIAL_FACEBOOK_CALLBACK_URL=https://lets-chat-gray.vercel.app/oauth/callback/facebook
