# Backend environment (Northflank / local). Copy values into your deployment env; do not commit secrets.

# --- Email (OTP verification) ---
# Default: no EMAIL_HOST → console backend → OTP appears in server stdout/logs only (not inbox).
# To deliver mail: set EMAIL_HOST (and usually user/password). Backend switches to SMTP automatically.

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-specific-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=20

# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Force a backend (optional). If unset and EMAIL_HOST is set, SMTP is used.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
# EMAIL_VERIFICATION_DELETE_AFTER_HOURS=2
