{
  "name": "lets-chat",
  "private": true,
  "scripts": {
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd src && ..\\.venv\\Scripts\\python.exe -m daphne -b 127.0.0.1 -p 8000 Justchat.asgi:application",
    "start:frontend": "cd frontend && npm run start",
    "venv": "start cmd /k \"cd /d %cd% && .venv\\Scripts\\activate.bat\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
