{
  "name": "lets-chat",
  "private": true,
  "scripts": {
    "start": "concurrently -n redis,backend,app -c cyan,blue,magenta \"npm run start:redis\" \"npm run start:backend\" \"npm run start:svelte\"",
    "start:redis": "docker compose up -d redis",
    "start:backend": "cd src && ..\\.venv\\Scripts\\python.exe -m daphne -b 127.0.0.1 -p 8000 Justchat.asgi:application",
    "start:frontend": "cd frontend && npm run start",
    "start:svelte": "cd app-svelte && npm run dev",
    "venv": "start cmd /k \"cd /d %cd% && .venv\\Scripts\\activate.bat\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
